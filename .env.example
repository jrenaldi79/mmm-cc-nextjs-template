# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# Never commit the .env.local file to git!

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Your Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Public site URL — used to build OAuth & email-confirmation redirect URLs.
# Local dev falls back to http://localhost:3000; set this in production.
# NEXT_PUBLIC_SITE_URL=https://your-app.example.com

# n8n LLM Agent (optional) — used by app/api/chat to stream an agent to the UI.
# This stays server-side; never expose it to the browser.
# N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/your-agent
# N8N_WEBHOOK_SECRET=your_shared_secret
